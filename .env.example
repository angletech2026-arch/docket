# Use one of the two.

# 1. Claude through the Anthropic API
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# 2. Any OpenAI-compatible endpoint (GMI Cloud, OpenAI, or a model running on your own machine)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.gmi-serving.com/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
#
# A local server, for example Ollama:
# LLM_API_KEY=local
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.3
